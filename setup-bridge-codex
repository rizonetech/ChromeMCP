#!/usr/bin/env bash
# WSL wrapper: installs/refreshes the Windows-side bridge for the Codex CDP port.
set -euo pipefail

SELF="$(readlink -f "$0")"
DIR="$(dirname "$SELF")"
# shellcheck source=lib/codex-lanes.sh
. "$DIR/lib/codex-lanes.sh"
PS1_WIN_PATH="$(wslpath -w "$DIR/launcher/Setup-WSL-Portproxy.ps1")"
lane="${1:-$(codex_lane_default)}"
if [[ "$lane" =~ ^[1-9][0-9]*$ ]]; then
  shift || true
else
  lane="$(codex_lane_default)"
fi
codex_lane_apply_runtime "$lane" "$DIR"
PORT="$CDP_PORT"
MODE_ARGS=()

for arg in "$@"; do
  case "$arg" in
    /remove|--remove) MODE_ARGS+=("-Remove") ;;
    /refresh|--refresh) MODE_ARGS+=("-Refresh") ;;
    --help|-h)
      sed -n '1,8p' "$0"
      exit 0
      ;;
    *)
      echo "ERROR: unknown argument: $arg" >&2
      exit 64
      ;;
  esac
done

POWERSHELL_EXE="$(command -v powershell.exe || true)"
if [ -z "$POWERSHELL_EXE" ]; then
  for candidate in \
    /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe \
    /mnt/c/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe
  do
    if [ -x "$candidate" ]; then
      POWERSHELL_EXE="$candidate"
      break
    fi
  done
fi

if [ -z "$POWERSHELL_EXE" ]; then
  echo "ERROR: powershell.exe not found. Ensure WSL Windows interop is enabled." >&2
  exit 1
fi

echo "Triggering Windows-side Codex bridge for CDP port $PORT."
echo "Watch for the UAC dialog on your Windows desktop."

PS_ARG_LIST=("-NoProfile" "-ExecutionPolicy" "Bypass" "-File" "$PS1_WIN_PATH" "-Port" "$PORT" "${MODE_ARGS[@]}")
PS_ARRAY="@("
for item in "${PS_ARG_LIST[@]}"; do
  escaped="${item//\'/\'\'}"
  PS_ARRAY+="'$escaped',"
done
PS_ARRAY="${PS_ARRAY%,})"

exec "$POWERSHELL_EXE" -NoProfile -Command \
  "Start-Process -Verb RunAs -FilePath powershell.exe -ArgumentList $PS_ARRAY"
