#!/usr/bin/env bash
# Acquire and describe Codex ChromeMCP lanes.
set -euo pipefail

SELF="$(readlink -f "$0")"
ROOT="$(dirname "$SELF")"
# shellcheck source=lib/codex-lanes.sh
. "$ROOT/lib/codex-lanes.sh"

STATE_DIR="${CODEX_CHROMEMCP_LANE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/chromemcp/codex-lanes}"

usage() {
  cat <<'HELP'
Usage:
  chromemcp codex-lane acquire [--lane N] [--max N] [--format shell|json|plain] [--owner TEXT]
  chromemcp codex-lane release N
  chromemcp codex-lane env [N] [--format shell|json|plain]
  chromemcp codex-lane status

Lane ports:
  lane 1 -> MCP 8941, upstream 8942, CDP 9232
  lane 2 -> MCP 8951, upstream 8952, CDP 9242
  lane N -> MCP 8931+(N*10), upstream 8932+(N*10), CDP 9222+(N*10)
HELP
}

print_lane() {
  local lane="$1"
  local format="${2:-shell}"
  case "$format" in
    shell) codex_lane_print_shell "$lane" ;;
    json) codex_lane_print_json "$lane" ;;
    plain)
      printf 'lane=%s mcp=http://127.0.0.1:%s/mcp cdp=%s profile=%s token=%s\n' \
        "$lane" "$(codex_lane_mcp_port "$lane")" "$(codex_lane_cdp_port "$lane")" \
        "$(codex_lane_profile_name "$lane")" "$(codex_lane_token_path "$lane")"
      ;;
    *) echo "ERROR: unknown format: $format" >&2; exit 64 ;;
  esac
}

lock_dir_for_lane() {
  printf '%s/lane-%s.lock\n' "$STATE_DIR" "$1"
}

cmd_acquire() {
  local requested="" max="${CODEX_CHROMEMCP_MAX_LANE:-4}" format="shell" owner="${USER:-codex}:$$"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --lane) requested="${2:?missing lane}"; shift 2 ;;
      --lane=*) requested="${1#--lane=}"; shift ;;
      --max) max="${2:?missing max}"; shift 2 ;;
      --max=*) max="${1#--max=}"; shift ;;
      --format) format="${2:?missing format}"; shift 2 ;;
      --format=*) format="${1#--format=}"; shift ;;
      --owner) owner="${2:?missing owner}"; shift 2 ;;
      --owner=*) owner="${1#--owner=}"; shift ;;
      --help|-h) usage; exit 0 ;;
      *) echo "ERROR: unknown acquire argument: $1" >&2; exit 64 ;;
    esac
  done

  mkdir -p "$STATE_DIR"
  local lane start end
  if [ -n "$requested" ]; then
    codex_lane_validate "$requested"
    start="$requested"; end="$requested"
  else
    start=1; end="$max"
  fi

  for lane in $(seq "$start" "$end"); do
    codex_lane_validate "$lane"
    local dir
    dir="$(lock_dir_for_lane "$lane")"
    if mkdir "$dir" 2>/dev/null; then
      {
        printf 'lane=%s\n' "$lane"
        printf 'owner=%s\n' "$owner"
        printf 'pid=%s\n' "$$"
        date -u '+created_at=%Y-%m-%dT%H:%M:%SZ'
        hostname | sed 's/^/host=/'
      } > "$dir/meta"
      print_lane "$lane" "$format"
      exit 0
    fi
  done

  echo "ERROR: no free Codex ChromeMCP lane in range ${start}-${end}" >&2
  exit 75
}

cmd_release() {
  local lane="${1:-}"
  [ -n "$lane" ] || { echo "ERROR: release requires a lane number" >&2; exit 64; }
  codex_lane_validate "$lane"
  local dir
  dir="$(lock_dir_for_lane "$lane")"
  case "$dir" in
    "$STATE_DIR"/lane-*.lock) ;;
    *) echo "ERROR: refusing to release unexpected lock path: $dir" >&2; exit 1 ;;
  esac
  if [ ! -d "$dir" ]; then
    echo "Codex lane $lane is not locked."
    exit 0
  fi
  rm -f "$dir/meta"
  rmdir "$dir"
  echo "Released Codex lane $lane."
}

cmd_env() {
  local lane="" format="shell"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --format) format="${2:?missing format}"; shift 2 ;;
      --format=*) format="${1#--format=}"; shift ;;
      --help|-h) usage; exit 0 ;;
      *)
        if [ -z "$lane" ]; then lane="$1"; shift; else echo "ERROR: unexpected argument: $1" >&2; exit 64; fi
        ;;
    esac
  done
  lane="${lane:-$(codex_lane_default)}"
  print_lane "$lane" "$format"
}

cmd_status() {
  mkdir -p "$STATE_DIR"
  echo "Codex ChromeMCP lanes:"
  for lane in $(seq 1 "${CODEX_CHROMEMCP_MAX_LANE:-4}"); do
    local dir lock="free"
    dir="$(lock_dir_for_lane "$lane")"
    if [ -d "$dir" ]; then
      lock="locked"
    fi
    printf '  lane %s: %s, MCP %s, CDP %s, profile %s\n' \
      "$lane" "$lock" "$(codex_lane_mcp_port "$lane")" "$(codex_lane_cdp_port "$lane")" \
      "$(codex_lane_profile_name "$lane")"
    if [ -f "$dir/meta" ]; then
      sed 's/^/    /' "$dir/meta"
    fi
  done
}

cmd="${1:-status}"
[ "$#" -gt 0 ] && shift || true
case "$cmd" in
  acquire) cmd_acquire "$@" ;;
  release) cmd_release "$@" ;;
  env) cmd_env "$@" ;;
  status) cmd_status "$@" ;;
  help|--help|-h) usage ;;
  *) echo "ERROR: unknown codex-lane command: $cmd" >&2; usage >&2; exit 64 ;;
esac
