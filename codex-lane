#!/usr/bin/env bash
# Back-compat alias: Codex lane allocation, delegating to the client-
# generalized `lane` CLI (equivalent to `chromemcp lane <cmd> --client codex`).
set -euo pipefail

SELF="$(readlink -f "$0")"
ROOT="$(dirname "$SELF")"

cmd="${1:-status}"
[ "$#" -gt 0 ] && shift || true

exec bash "$ROOT/lane" "$cmd" --client codex "$@"
